[Unit]
Description=restic ({{ restic_identifier }})
{% for service in restic_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in restic_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=oneshot
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ restic_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStart=-{{ devture_systemd_docker_base_host_command_docker }} run \
      --rm \
      --name {{ restic_identifier }} \
      --hostname={{ restic_container_hostname }} \
      --log-driver=none \
      --user=0:0 \
      --cap-drop=ALL \
      --cap-add=SETUID \
      --cap-add=SETGID \
      --cap-add=CHOWN \
      --cap-add=FOWNER \
      --cap-add=DAC_OVERRIDE \
      --read-only \
      --network={{ restic_container_network }} \
      --env-file={{ restic_base_path }}/env \
      {% for volume in restic_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      --tmpfs=/root/.cache:rw,noexec,nosuid,size={{ restic_container_tmpfs_cache_size }} \
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ restic_container_tmpfs_tmp_size }} \
      {% for arg in restic_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ restic_container_image }} \
      {% for arg in restic_process_extra_arguments %}
      {{ arg }} \
      {% endfor %}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ restic_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ restic_identifier }} 2>/dev/null || true'
SyslogIdentifier={{ restic_identifier }}

[Install]
WantedBy=multi-user.target
