TZ={{ restic_environment_variables_tz }}

{% if restic_environment_variables_restic_repository != '' %}
RESTIC_REPOSITORY={{ restic_environment_variables_restic_repository }}
{% endif %}

{% if restic_environment_variables_restic_password != '' %}
RESTIC_PASSWORD={{ restic_environment_variables_restic_password }}
{% endif %}

{% if restic_environment_variables_restic_pack_size != '' %}
RESTIC_PACK_SIZE={{ restic_environment_variables_restic_pack_size }}
{% endif %}

{% if restic_environment_variables_rest_username != '' %}
RESTIC_REST_USERNAME={{ restic_environment_variables_rest_username }}
{% endif %}

{% if restic_environment_variables_rest_password != '' %}
RESTIC_REST_PASSWORD={{ restic_environment_variables_rest_password }}
{% endif %}

{{ restic_environment_variables_additional_variables }}
